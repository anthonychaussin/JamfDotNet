<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>JamfDotNet.School</RootNamespace>
    <AssemblyName>JamfDotNet.School</AssemblyName>
    <Description>Typed .NET client for the Jamf School REST API.</Description>
    <PackageId>JamfDotNet.School</PackageId>
    <PackageTags>jamf;school;mdm;education;api</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageIcon>package-icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JamfDotNet.Core\JamfDotNet.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\assets\package-icon-school.png" Pack="true" PackagePath="package-icon.png" Link="package-icon.png" />
  </ItemGroup>
</Project>
