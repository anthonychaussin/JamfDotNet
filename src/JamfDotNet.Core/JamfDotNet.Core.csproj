<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>JamfDotNet.Core</RootNamespace>
    <AssemblyName>JamfDotNet.Core</AssemblyName>
    <Description>Shared authentication, options, and helpers for JamfDotNet clients.</Description>
    <PackageId>JamfDotNet.Core</PackageId>
    <PackageTags>jamf;jamf-pro;mdm;api;oauth</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageIcon>package-icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\assets\package-icon-core.png" Pack="true" PackagePath="package-icon.png" Link="package-icon.png" />
    <None Include="..\..\assets\icon-core.ico" Link="icon.ico" />
  </ItemGroup>

</Project>
