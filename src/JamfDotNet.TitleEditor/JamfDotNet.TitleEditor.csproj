<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>JamfDotNet.TitleEditor</RootNamespace>
    <AssemblyName>JamfDotNet.TitleEditor</AssemblyName>
    <Description>Strongly typed .NET client for the Jamf Title Editor API.</Description>
    <PackageId>JamfDotNet.TitleEditor</PackageId>
    <PackageTags>jamf;title-editor;patch;software-titles;api;kiota;openapi</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageIcon>package-icon.png</PackageIcon>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JamfDotNet.Core\JamfDotNet.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\assets\package-icon-titleeditor.png" Pack="true" PackagePath="package-icon.png" Link="package-icon.png" />
  </ItemGroup>
</Project>
