<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>JamfDotNet.Classic</RootNamespace>
    <AssemblyName>JamfDotNet.Classic</AssemblyName>
    <Description>Strongly typed .NET client for the Jamf Classic API (/JSSResource).</Description>
    <PackageId>JamfDotNet.Classic</PackageId>
    <PackageTags>jamf;jamf-classic;jssresource;mdm;api;kiota;openapi</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageIcon>package-icon.png</PackageIcon>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JamfDotNet.Core\JamfDotNet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\assets\package-icon-classic.png" Pack="true" PackagePath="package-icon.png" Link="package-icon.png" />
    <None Include="..\..\assets\icon-classic.ico" Link="icon.ico" />
  </ItemGroup>

</Project>
