          "expires": { "type": "integer", "description": "Unix epoch seconds" }
        }
      },
      "SoftwareTitleList": {
        "type": "object",
        "properties": {
          "softwareTitleId": { "type": "integer" },
          "enabled": { "type": "boolean" },
          "name": { "type": "string" },
          "publisher": { "type": "string" },
          "appName": { "type": "string" },
          "bundleId": { "type": "string" },
          "lastModified": { "type": "string", "format": "date-time" },
          "currentVersion": { "type": "string" },
          "requirements": { "type": "integer" },
          "patches": { "type": "integer" },
          "id": { "type": "string" },
          "sourceId": { "type": "integer" },
          "source": { "type": "string" }
        }
      },
      "SoftwareTitle": {
        "type": "object",
        "properties": {
          "softwareTitleId": { "type": "integer" },
          "sourceId": { "type": "integer" },
          "enabled": { "type": "boolean" },
          "name": { "type": "string" },
          "publisher": { "type": "string" },
