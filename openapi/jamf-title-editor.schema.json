          "id": { "type": "string" }
        }
      },
      "Source": {
        "type": "object",
        "properties": {
          "sourceId": { "type": "integer" },
          "name": { "type": "string" },
          "hostName": { "type": "string" },
          "port": { "type": "integer" },
          "sslEnabled": { "type": "boolean" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "userId": { "type": "integer" },
          "username": { "type": "string" },
          "email": { "type": "string" },
          "enabled": { "type": "boolean" }
        }
      },
      "Patch": {
        "type": "object",
        "properties": {
          "patchId": { "type": "integer" },
          "softwareTitleId": { "type": "integer" },
          "version": { "type": "string" },
          "enabled": { "type": "boolean" },
          "minimumOperatingSystem": { "type": "string" },
          "reboot": { "type": "boolean" }
        }
      },
      "Preference": {
        "type": "object",
        "properties": {
